meta {
  name: Cancel Shipment Request (Customer)
  type: http
  seq: 8
}

post {
  url: {{url}}/shipment-requests/{{shipmentRequestId}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "reason": "Shipment no longer required"
  }
}

docs {
  # Cancel Shipment Request
  Customer cancels their pending shipment request.
}
