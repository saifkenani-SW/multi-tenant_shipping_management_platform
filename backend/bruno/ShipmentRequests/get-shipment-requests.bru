meta {
  name: Get Shipment Requests
  type: http
  seq: 2
}

get {
  url: {{url}}/shipment-requests?page=1&limit=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  # List Shipment Requests
  Customer: sees their own requests.
  Employee: sees requests assigned to their tenant (`targetTenantId` = their
  tenant, i.e. after the customer approved a quotation from their company).
}
