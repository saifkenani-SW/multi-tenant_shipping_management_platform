meta {
  name: Change Password
  type: http
  seq: 7
}

put {
  url: {{url}}/customer/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "currentPassword": "SecurePassword123!",
    "newPassword": "NewSecurePassword123!"
  }
}

docs {
  # Change Password
  Changes the authenticated customer's password and revokes existing refresh sessions.
}
