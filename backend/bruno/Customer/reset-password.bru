meta {
  name: Reset Password
  type: http
  seq: 6
}

post {
  url: {{url}}/customer/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "john.doe@example.com",
    "otp": "123456",
    "newPassword": "NewSecurePassword123!"
  }
}

docs {
  # Reset Password
  Verifies the password-reset OTP, changes the password, and revokes existing refresh sessions.
}
