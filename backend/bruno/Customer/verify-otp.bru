meta {
  name: Verify OTP & Create Account (Step 2)
  type: http
  seq: 3
}

post {
  url: {{url}}/customer/verify-otp
  body: json
  auth: none
}

body:json {
  {
    "email": "john.doe@example.com",
    "otp": "123456"
  }
}

docs {
  # Verify OTP & Complete Account Creation
  Verifies the received 6-digit OTP code and creates the customer account.
  Does not log the user in automatically — call `/auth/login` afterwards.
}
