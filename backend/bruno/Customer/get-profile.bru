get {
  url: {{url}}/customer/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  # Get Logged-in Customer Profile
  Returns full profile details for the authenticated customer. Restricted to `CUSTOMER` type users.
}
