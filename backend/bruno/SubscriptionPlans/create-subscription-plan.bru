meta {
  name: Create Subscription Plan
  type: http
  seq: 1
}

post {
  url: {{url}}/subscription-plans
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Enterprise Logistics Tier",
    "description": "Full-scale logistics management with unlimited branches and advanced analytics",
    "priceMonthly": 499.99,
    "priceYearly": 4999.99,
    "maxBranches": 50,
    "maxWarehouses": 20,
    "maxEmployees": 500,
    "maxVehicles": 100,
    "maxZones": 50,
    "maxMonthlyShipments": 100000,
    "maxMonthlyParcels": 200000,
    "isActive": true
  }
}

docs {
  # Create Subscription Plan
  Creates a new platform subscription plan. Restricted to `PLATFORM_ADMIN`.
}
