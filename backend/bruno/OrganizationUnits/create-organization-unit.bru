meta {
  name: Create Organization Unit
  type: http
  seq: 1
}

post {
  url: {{url}}/organization-units
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  x-tenant-id: 00000000-0000-7000-8000-000000000101
}

body:json {
  {
    "name": "Amman Main Branch",
    "orgType": "REGION",
    "addressLine": "Downtown, Amman",
    "longitude": 35.9106,
    "latitude": 31.9539
  }
}

docs {
  # Create Organization Unit
  Creates a new organizational unit. Restricted to `PLATFORM_ADMIN` or an authorized `EMPLOYEE`.

  `PLATFORM_ADMIN` must send `x-tenant-id`. An employee's tenant comes from the selected login profile.
}
