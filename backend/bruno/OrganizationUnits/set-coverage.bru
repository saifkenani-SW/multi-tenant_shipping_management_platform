meta {
  name: Set Unit Geographic Coverage
  type: http
  seq: 5
}

put {
  url: {{url}}/organization-units/{{orgUnitId}}/coverage
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

