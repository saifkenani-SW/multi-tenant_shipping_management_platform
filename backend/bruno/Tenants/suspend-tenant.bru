meta {
  name: Suspend Tenant
  type: http
  seq: 5
}

post {
  url: {{url}}/tenants/{{tenantId}}/suspend
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "reason": "Payment default or compliance verification required"
  }
}

docs {
  # Suspend Tenant
  Suspends a tenant account and revokes active user sessions for the tenant.
}
