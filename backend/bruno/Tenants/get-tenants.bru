}

params:query {
  page: 1
  limit: 30
  ~search: TAX-987654
  ~searchType: tax_numb
}

auth:bearer {
  token: {{token}}
}

docs {
  # Get Tenants
  Retrieves a paginated list of all tenants. Restricted to `PLATFORM_ADMIN` users only.
  
  ## Usage
  - `{{url}}` resolves to the base API path.
  - `{{token}}` is the bearer token for a platform admin.
  - `page` (optional): Page number (default: 1)
  - `limit` (optional): Number of items per page (default: 10)
  - `search` (optional): Search by tenant name or tax number (case-insensitive)
  - `searchType` (optional): Field to search by (`name` or `tax_number`, default: `name`)
  
  ## Expected JSON Response
  ```json
  {
    "success": true,
    "data": {
      "data": [
        {
          "id": "123e4567-e89b-12d3-a456-426614174000",
          "name": "Global Logistics",
          "status": "ACTIVE",
          "createdAt": "2026-07-16T12:00:00.000Z"
        }
      ],
      "meta": {
        "page": 1,
        "limit": 10,
        "total": 1
      }
    },
    "timestamp": "2026-07-16T12:00:00.000Z"
  }
  ```
}
