meta {
  name: Logout User
  type: http
  seq: 3
}

post {
  url: {{url}}/auth/logout
  body: none
  auth: bearer
}

headers {
  client-type: WEB
}

auth:bearer {
  token: {{token}}
}

docs {
# Logout User
Revokes the current session and clears authentication cookies if using `WEB` client.

## Permissions
Authenticated users (`PLATFORM_ADMIN`, `EMPLOYEE`, `CUSTOMER`).
}
