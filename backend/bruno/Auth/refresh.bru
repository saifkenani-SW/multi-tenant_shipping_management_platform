meta {
  name: Refresh Tokens
  type: http
  seq: 2
}

post {
  url: {{url}}/auth/refresh
  body: json
  auth: none
}

headers {
  client-type: MOBILE
}

body:json {
  {
    "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
  }
}

docs {
  # Refresh Tokens
  Generates new access and refresh tokens using a valid refresh token.

  ## Request Notes
  For `WEB` client type, the refresh token is automatically read from `refresh_token` cookie if present.

  ## Expected Response
  ```json
  {
    "accessToken": "eyJhbGciOi...",
    "refreshToken": "eyJhbGciOi..."
  }
  ```
}
