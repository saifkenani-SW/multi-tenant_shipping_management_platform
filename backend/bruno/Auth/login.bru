meta {
  name: Login User
  type: http
  seq: 1
}

post {
  url: {{url}}/auth/login
  body: json
  auth: none
}

headers {
  client-type: MOBILE
}

body:json {
  {
    "email": "owner@logisticsplatform.com",
    "password": "password123"
  }
}

docs {
  # Login Endpoint
  Authenticates a user and returns JWT access and refresh tokens.

  ## Client Types
  - `WEB`: Tokens set in HttpOnly cookies (`access_token`, `refresh_token`).
  - `MOBILE`: Tokens returned directly in JSON response body.

  ## Expected JSON Response
  ```json
  {
    "accessToken": "eyJhbGciOi...",
    "refreshToken": "eyJhbGciOi...",
    "user": {
      "id": "01948f6c-82e4-7d5a-8b1a-2e4a8b9c0d1e",
      "email": "owner@logisticsplatform.com",
      "type": "PLATFORM_ADMIN"
    }
  }
  ```
}
