  parcel_id                 String             @db.Uuid
  organization_unit_id      String?            @db.Uuid
  trip_id                   String?            @db.Uuid
  action_type               String             @db.VarChar(30)
  parcel_status_snapshot    String             @db.VarChar(30)
  parcel_condition_snapshot String             @default("NORMAL") @db.VarChar(20)
  performed_by_employee_id  String             @db.Uuid
  notes                     String?
  created_at                DateTime           @default(now()) @db.Timestamp(6)
  organization_unit         organization_unit? @relation(fields: [organization_unit_id], references: [id], onUpdate: NoAction)
  parcel                    parcel             @relation(fields: [parcel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee                  employee           @relation(fields: [performed_by_employee_id], references: [id], onUpdate: NoAction)
  tenant                    tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  trip                      trip?              @relation(fields: [trip_id], references: [id], onUpdate: NoAction)

  @@index([parcel_id, created_at(sort: Desc)], map: "idx_parcel_movement_parcel")
