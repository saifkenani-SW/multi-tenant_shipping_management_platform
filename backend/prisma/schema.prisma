  transport_manifest_transport_manifest_origin_org_unit_idToorganization_unit      transport_manifest[]        @relation("transport_manifest_origin_org_unit_idToorganization_unit")
  trip_trip_destination_org_unit_idToorganization_unit                             trip[]                      @relation("trip_destination_org_unit_idToorganization_unit")
  trip_trip_origin_org_unit_idToorganization_unit                                  trip[]                      @relation("trip_origin_org_unit_idToorganization_unit")

  @@index([tree_path], map: "idx_org_unit_path", type: Gist)
  @@index([tenant_id], map: "idx_org_unit_tenant")
  @@index([tenant_id, org_type], map: "idx_org_unit_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model parcel {
  id                                                              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                                                       String             @db.Uuid
  customer_shipment_id                                            String             @db.Uuid
  tracking_number                                                 String             @db.VarChar(50)
  actual_weight_kg                                                Decimal            @db.Decimal(10, 2)
  length_cm                                                       Decimal            @db.Decimal(10, 2)
  width_cm                                                        Decimal            @db.Decimal(10, 2)
  height_cm                                                       Decimal            @db.Decimal(10, 2)
  volumetric_weight_kg                                            Decimal?           @default(dbgenerated("round((((length_cm * width_cm) * height_cm) / 5000.0), 2)")) @db.Decimal(10, 2)
  current_status                                                  String             @default("CREATED") @db.VarChar(30)
  current_condition                                               String             @default("NORMAL") @db.VarChar(20)
  current_org_unit_id                                             String?            @db.Uuid
  next_org_unit_id                                                String?            @db.Uuid
  qr_code_url                                                     String?            @db.VarChar(500)
  created_at                                                      DateTime           @default(now()) @db.Timestamp(6)
  updated_at                                                      DateTime           @default(now()) @db.Timestamp(6)
  manifest_item                                                   manifest_item[]
  organization_unit_parcel_current_org_unit_idToorganization_unit organization_unit? @relation("parcel_current_org_unit_idToorganization_unit", fields: [current_org_unit_id], references: [id], onUpdate: NoAction)
  customer_shipment                                               customer_shipment  @relation(fields: [customer_shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization_unit_parcel_next_org_unit_idToorganization_unit    organization_unit? @relation("parcel_next_org_unit_idToorganization_unit", fields: [next_org_unit_id], references: [id], onUpdate: NoAction)
  tenant                                                          tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parcel_movement                                                 parcel_movement[]
  proof_of_delivery                                               proof_of_delivery?
  support_ticket                                                  support_ticket[]

  @@unique([tenant_id, tracking_number], map: "uq_tenant_tracking")
  @@index([customer_shipment_id], map: "idx_parcel_shipment")
  @@index([tenant_id, current_status], map: "idx_parcel_tenant")
  @@index([tracking_number], map: "idx_parcel_tracking")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model parcel_movement {
  id                        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
