generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

generator kysely {
  provider        = "prisma-kysely"
  output          = "../src/infrastructure/database/generated/kysely"
  previewFeatures = ["partialIndexes"]
  fileName        = "types.ts"
}

datasource db {
  provider   = "postgresql"
  extensions = [ltree, postgis]
}

model assignment_role {
  id                  String              @id @default(uuid(7)) @db.Uuid
  assignment_id       String              @db.Uuid
  role_id             String              @db.Uuid
  granted_at          DateTime            @default(now()) @db.Timestamp(6)
  employee_assignment employee_assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role                role                @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([assignment_id, role_id], map: "uq_assignment_role")
}

model audit_log {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenant_id        String?  @db.Uuid
  actor_user_id    String?  @db.Uuid
  actor_ip         String?  @db.Inet
  actor_user_agent String?
  event_type       String   @db.VarChar(50)
  entity_type      String?  @db.VarChar(50)
  entity_id        String?  @db.Uuid
  old_values       Json?
  new_values       Json?
  metadata         Json?
  created_at       DateTime @default(now()) @db.Timestamp(6)
  users            users?   @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)
  tenant           tenant?  @relation(fields: [tenant_id], references: [id], onUpdate: NoAction)
}

model customer_address {
  id               String                   @id @default(uuid(7)) @db.Uuid
  customer_id      String                   @db.Uuid
  label            String?                  @db.VarChar(100)
  address_line     String                   @db.VarChar(500)
  location         Unsupported("geometry")?
  is_default       Boolean                  @default(false)
  created_at       DateTime                 @default(now()) @db.Timestamp(6)
  customer_profile customer_profile         @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([location], map: "idx_customer_address_location", type: Gist)
}

model customer_profile {
  id                String             @id @default(uuid(7)) @db.Uuid
  user_id           String             @unique @db.Uuid
  full_name         String             @db.VarChar(255)
  phone             String             @db.VarChar(50)
  profile_image_key String?            @db.VarChar(500)
  created_at        DateTime           @default(now()) @db.Timestamp(6)
  updated_at        DateTime           @updatedAt
  customer_address  customer_address[]
  users             users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer_tenant   customer_tenant[]
  shipment_request  shipment_request[]
}

model customer_shipment {
  id                         String                @id @default(uuid(7)) @db.Uuid
  tenant_id                  String                @db.Uuid
  sender_national_id         String?               @db.VarChar(50)
  shipment_request_id        String?               @db.Uuid
  origin_org_unit_id         String                @db.Uuid
  destination_org_unit_id    String                @db.Uuid
  receiver_name              String                @db.VarChar(255)
  receiver_phone             String                @db.VarChar(50)
  payment_responsibility     PaymentResponsibility @default(SENDER)
  total_chargeable_weight_kg Decimal?              @default(0) @db.Decimal(10, 2)
  status                     ShipmentStatus        @default(PROCESSING)
  created_at                 DateTime              @default(now()) @db.Timestamp(6)
  updated_at                 DateTime              @updatedAt
  service_level              ServiceLevel          @default(STANDARD)
  version                    Int                   @default(1)
  sender_name                String                @db.VarChar(255)
  sender_phone               String                @db.VarChar(50)
  created_by_employee_id     String?               @db.Uuid
  created_by_employee_name   String?               @db.VarChar(255)
  created_by_employee        employee?             @relation(fields: [created_by_employee_id], references: [id], onUpdate: NoAction)
  destination_org_unit       organization_unit     @relation("customer_shipment_destinationToorganization_unit", fields: [destination_org_unit_id], references: [id], onUpdate: NoAction)
  origin_org_unit            organization_unit     @relation("customer_shipment_originToorganization_unit", fields: [origin_org_unit_id], references: [id], onUpdate: NoAction)
  shipment_request           shipment_request?     @relation(fields: [shipment_request_id], references: [id], onUpdate: NoAction)
  tenant                     tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoice                    invoice[]
  parcel                     parcel[]
  support_ticket             support_ticket[]

  @@index([tenant_id], map: "idx_customer_shipment_tenant")
}

model customer_tenant {
  id                   String           @id @default(uuid(7)) @db.Uuid
  tenant_id            String           @db.Uuid
  customer_profile_id  String           @db.Uuid
  first_interaction_at DateTime         @default(now()) @db.Timestamp(6)
  customer_profile     customer_profile @relation(fields: [customer_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant               tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, customer_profile_id], map: "uq_customer_tenant")
}

model employee {
  id                  String                @id @default(uuid(7)) @db.Uuid
  tenant_id           String                @db.Uuid
  user_id             String                @db.Uuid
  employee_code       String                @db.VarChar(50)
  national_id         String?               @db.VarChar(50)
  full_name           String                @db.VarChar(255)
  is_active           Boolean               @default(true)
  deactivated_at      DateTime?             @db.Timestamp(6)
  created_at          DateTime              @default(now()) @db.Timestamp(6)
  updated_at          DateTime              @updatedAt
  customer_shipment   customer_shipment[]
  tenant              tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee_assignment employee_assignment[]
  parcel_movement     parcel_movement[]
  payment             payment[]
  proof_of_delivery   proof_of_delivery[]
  quotation           quotation[]
  shipment_request    shipment_request[]
  support_ticket                  support_ticket[]
  trip_as_driver                  trip[]                @relation("trip_driverToemployee")
  trip_as_creator                 trip[]                @relation("trip_created_byToemployee")
  vehicle_assignment  vehicle_assignment[]
  manifest_as_creator             transport_manifest[]  @relation("manifest_created_byToemployee")
  manifest_item_as_adder          manifest_item[]       @relation("manifest_item_added_byToemployee")

  @@unique([tenant_id, employee_code], map: "uq_tenant_emp_code")
  @@unique([tenant_id, user_id], map: "uq_tenant_user")
}

model employee_assignment {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tenant_id            String            @db.Uuid
  employee_id          String            @db.Uuid
  organization_unit_id String            @db.Uuid
  is_active            Boolean           @default(true)
  created_at           DateTime          @default(now()) @db.Timestamp(6)
  assignment_role      assignment_role[]
  employee             employee          @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization_unit    organization_unit @relation(fields: [organization_unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant               tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employee_id, organization_unit_id], map: "uq_employee_org_unit")
}

model global_location {
  id                            String                      @id @default(uuid(7)) @db.Uuid
  parent_id                     String?                     @db.Uuid
  name                          String                      @db.VarChar(255)
  type                          LocationType
  location                      Unsupported("geometry")?
  global_location               global_location?            @relation("global_locationToglobal_location", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_global_location         global_location[]           @relation("global_locationToglobal_location")
  org_unit_location_mapping     org_unit_location_mapping[]
  destination_shipment_requests shipment_request[]          @relation("shipment_request_destinationToglobal_location")
  origin_shipment_requests      shipment_request[]          @relation("shipment_request_originToglobal_location")

  @@index([location], map: "idx_global_location_geom", type: Gist)
}

model invoice {
  id                      String                @id @default(uuid(7)) @db.Uuid
  version                 Int                   @default(1)
  tenant_id               String                @db.Uuid
  customer_shipment_id    String?               @db.Uuid
  sender_name             String                @db.VarChar(255)
  sender_phone            String                @db.VarChar(50)
  receiver_name           String                @db.VarChar(255)
  receiver_phone          String                @db.VarChar(50)
  origin_org_unit_id      String                @db.Uuid
  destination_org_unit_id String                @db.Uuid
  invoice_number          String                @db.VarChar(100)
  subtotal                Decimal               @db.Decimal(10, 2)
  handling_fees           Decimal               @default(0) @db.Decimal(10, 2)
  tax_amount              Decimal               @default(0) @db.Decimal(10, 2)
  discount_amount         Decimal               @default(0) @db.Decimal(10, 2)
  total_amount            Decimal               @db.Decimal(10, 2)
  payment_responsibility  PaymentResponsibility @default(SENDER)
  currency                String                @default("USD") @db.Char(3)
  status                  InvoiceStatus         @default(UNPAID)
  due_date                DateTime?             @db.Timestamp(6)
  created_at              DateTime              @default(now()) @db.Timestamp(6)
  updated_at              DateTime              @updatedAt
  customer_shipment       customer_shipment?    @relation(fields: [customer_shipment_id], references: [id], onUpdate: NoAction)
  tenant                  tenant                @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  origin_org_unit         organization_unit     @relation("invoice_originToorganization_unit", fields: [origin_org_unit_id], references: [id], onUpdate: NoAction)
  destination_org_unit    organization_unit     @relation("invoice_destinationToorganization_unit", fields: [destination_org_unit_id], references: [id], onUpdate: NoAction)
  payment                 payment[]

  @@unique([tenant_id, invoice_number], map: "uq_tenant_invoice")
  @@index([tenant_id, status], map: "idx_invoice_tenant_status")
  @@index([tenant_id, sender_phone], map: "idx_invoice_sender_phone")
  @@index([origin_org_unit_id], map: "idx_invoice_origin_org_unit")
  @@index([destination_org_unit_id], map: "idx_invoice_destination_org_unit")
}

model invoice_counter {
  tenant_id   String   @db.Uuid
  year        Int
  last_number Int      @default(0)
  updated_at  DateTime @updatedAt
  tenant      tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([tenant_id, year])
}

model manifest_item {
  id                       String             @id @default(uuid(7)) @db.Uuid
  manifest_id              String             @db.Uuid
  parcel_id                String             @db.Uuid
  status                   ManifestItemStatus @default(PENDING_LOAD)
  loaded_at                DateTime?          @db.Timestamp(6)
  unloaded_at              DateTime?          @db.Timestamp(6)
  added_by_employee_id     String?            @db.Uuid
  added_by_employee_name   String?            @db.VarChar(255)
  employee                 employee?          @relation("manifest_item_added_byToemployee", fields: [added_by_employee_id], references: [id], onUpdate: NoAction)
  transport_manifest       transport_manifest @relation(fields: [manifest_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parcel                   parcel             @relation(fields: [parcel_id], references: [id], onUpdate: NoAction)

  @@unique([manifest_id, parcel_id], map: "uq_manifest_parcel")
}


model notification {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenant_id         String?             @db.Uuid
  recipient_user_id String              @db.Uuid
  notification_type NotificationType
  title             String              @db.VarChar(255)
  body              String
  data              Json?
  channel           NotificationChannel
  is_read           Boolean             @default(false)
  read_at           DateTime?           @db.Timestamp(6)
  sent_at           DateTime?           @db.Timestamp(6)
  status            NotificationStatus  @default(PENDING)
  created_at        DateTime            @default(now()) @db.Timestamp(6)
  users             users               @relation(fields: [recipient_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant            tenant?             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model organization_unit {
  id                                                                               String                      @id @default(uuid(7)) @db.Uuid
  tenant_id                                                                        String                      @db.Uuid
  parent_id                                                                        String?                     @db.Uuid
  zone_id                                                                          String?                     @db.Uuid
  tree_path                                                                        Unsupported("ltree")?
  name                                                                             String                      @db.VarChar(255)
  org_type                                                                         OrgType
  address_line                                                                     String?                     @db.VarChar(500)
  location                                                                         Unsupported("geometry")?
  is_active                                                                        Boolean                     @default(true)
  created_at                                                                       DateTime                    @default(now()) @db.Timestamp(6)
  updated_at                                                                       DateTime                    @updatedAt
  customer_shipment_destination                                                    customer_shipment[]         @relation("customer_shipment_destinationToorganization_unit")
  customer_shipment_origin                                                         customer_shipment[]         @relation("customer_shipment_originToorganization_unit")
  employee_assignment                                                              employee_assignment[]
  org_unit_location_mapping                                                        org_unit_location_mapping[]
  organization_unit                                                                organization_unit?          @relation("organization_unitToorganization_unit", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_organization_unit                                                          organization_unit[]         @relation("organization_unitToorganization_unit")
  tenant                                                                           tenant                      @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant_zone                                                                      tenant_zone?                @relation(fields: [zone_id], references: [id], onUpdate: NoAction)
  parcel_parcel_current_org_unit_idToorganization_unit                             parcel[]                    @relation("parcel_current_org_unit_idToorganization_unit")
  parcel_destination_org_unit                                                      parcel[]                    @relation("parcel_destination_org_unit")
  parcel_movement                                                                  parcel_movement[]
  payment                                                                          payment[]
  quotation_destination                                                            quotation[]                 @relation("quotation_destinationToorganization_unit")
  quotation_origin                                                                 quotation[]                 @relation("quotation_originToorganization_unit")
  transport_manifest_transport_manifest_destination_org_unit_idToorganization_unit transport_manifest[]        @relation("transport_manifest_destination_org_unit_idToorganization_unit")
  transport_manifest_transport_manifest_origin_org_unit_idToorganization_unit      transport_manifest[]        @relation("transport_manifest_origin_org_unit_idToorganization_unit")
  trip_trip_destination_org_unit_idToorganization_unit                             trip[]                      @relation("trip_destination_org_unit_idToorganization_unit")
  trip_trip_origin_org_unit_idToorganization_unit                                  trip[]                      @relation("trip_origin_org_unit_idToorganization_unit")
  invoice_origin_org_unit                                                          invoice[]                   @relation("invoice_originToorganization_unit")
  invoice_destination_org_unit                                                     invoice[]                   @relation("invoice_destinationToorganization_unit")

  @@index([location], map: "idx_org_unit_location", type: Gist)
}

model parcel {
  id                                                              String             @id @default(uuid(7)) @db.Uuid
  tenant_id                                                       String             @db.Uuid
  customer_shipment_id                                            String             @db.Uuid
  tracking_number                                                 String             @unique(map: "uq_tracking") @db.VarChar(50)
  description                                                     String?            @db.VarChar(500)
  category                                                        String?            @db.VarChar(100)
  parcel_type                                                     ParcelType         @default(PACKAGE)
  is_fragile                                                      Boolean            @default(false)
  requires_upright_handling                                       Boolean            @default(false)
  temperature_sensitive                                           Boolean            @default(false)
  actual_weight_kg                                                Decimal            @db.Decimal(10, 2)
  length_cm                                                       Decimal            @db.Decimal(10, 2)
  width_cm                                                        Decimal            @db.Decimal(10, 2)
  height_cm                                                       Decimal            @db.Decimal(10, 2)
  volumetric_weight_kg                                            Decimal?           @db.Decimal(10, 2)
  current_status                                                  ParcelStatus       @default(PROCESSING)
  current_condition                                               ParcelCondition    @default(NORMAL)
  current_org_unit_id                                             String?            @db.Uuid
  created_at                                                      DateTime           @default(now()) @db.Timestamp(6)
  updated_at                                                      DateTime           @updatedAt
  destination_org_unit_id                                         String?            @db.Uuid
  label_key                                                       String?            @db.VarChar(500)
  version                                                         Int                @default(1)
  manifest_item                                                   manifest_item[]
  organization_unit_parcel_current_org_unit_idToorganization_unit organization_unit? @relation("parcel_current_org_unit_idToorganization_unit", fields: [current_org_unit_id], references: [id], onUpdate: NoAction)
  customer_shipment                                               customer_shipment  @relation(fields: [customer_shipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  destination_org_unit                                            organization_unit? @relation("parcel_destination_org_unit", fields: [destination_org_unit_id], references: [id], onUpdate: NoAction)
  tenant                                                          tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parcel_movement                                                 parcel_movement[]
  proof_of_delivery                                               proof_of_delivery?
  support_ticket                                                  support_ticket[]

  @@index([current_org_unit_id])
  @@index([customer_shipment_id])
}

model parcel_movement {
  id                       String             @id @default(uuid(7)) @db.Uuid
  tenant_id                String             @db.Uuid
  parcel_id                String             @db.Uuid
  trip_id                  String?            @db.Uuid
  organization_unit_id     String?            @db.Uuid
  performed_by_employee_id String             @db.Uuid
  action_type              ActionType
  previous_status          ParcelStatus?
  new_status               ParcelStatus
  previous_condition       ParcelCondition?
  new_condition            ParcelCondition
  organization_unit_name   String?
  organization_type        OrgType?
  organization_latitude    Decimal?           @db.Decimal(10, 7)
  organization_longitude   Decimal?           @db.Decimal(10, 7)
  trip_number              String?
  performed_by_name        String
  metadata                 Json?
  notes                    String?
  created_at               DateTime           @default(now()) @db.Timestamp(6)
  organization_unit        organization_unit? @relation(fields: [organization_unit_id], references: [id])
  parcel                   parcel             @relation(fields: [parcel_id], references: [id], onDelete: Cascade)
  employee                 employee           @relation(fields: [performed_by_employee_id], references: [id])
  tenant                   tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  trip                     trip?              @relation(fields: [trip_id], references: [id])

  @@index([organization_unit_id, created_at])
  @@index([parcel_id, created_at])
}

model payment {
  id                       String             @id @default(uuid(7)) @db.Uuid
  tenant_id                String             @db.Uuid
  invoice_id               String             @db.Uuid
  collected_by_employee_id String?            @db.Uuid
  organization_unit_id     String?            @db.Uuid
  amount                   Decimal            @db.Decimal(10, 2)
  payment_method           PaymentMethod
  transaction_reference    String?            @db.VarChar(255)
  gateway_response         Json?
  status                   PaymentStatus      @default(COMPLETED)
  created_at               DateTime           @default(now()) @db.Timestamp(6)
  employee                 employee?          @relation(fields: [collected_by_employee_id], references: [id], onUpdate: NoAction)
  invoice                  invoice            @relation(fields: [invoice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization_unit        organization_unit? @relation(fields: [organization_unit_id], references: [id], onUpdate: NoAction)
  tenant                   tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model permission {
  id              String            @id @default(uuid(7)) @db.Uuid
  name            String            @unique @db.VarChar(150)
  resource        String            @db.VarChar(100)
  action          String            @db.VarChar(50)
  description     String?           @db.VarChar(255)
  role_permission role_permission[]
}

model proof_of_delivery {
  id                         String           @id @default(uuid(7)) @db.Uuid
  tenant_id                  String           @db.Uuid
  parcel_id                  String           @unique(map: "uq_parcel_pod") @db.Uuid
  delivered_by_employee_id   String           @db.Uuid
  delivered_by_employee_name String           @db.VarChar(255)
  collection_method          CollectionMethod @default(CUSTOMER)
  received_by_name           String           @db.VarChar(255)
  received_by_national_id    String?          @db.VarChar(50)
  otp_verified               Boolean          @default(false)
  otp_verified_at            DateTime?        @db.Timestamp(6)
  signature_key              String?          @db.VarChar(500)
  id_photo_key               String?          @db.VarChar(500)
  parcel_photo_key           String?          @db.VarChar(500)
  additional_photo_key       String?          @db.VarChar(500)
  delivery_lat               Decimal?         @db.Decimal(10, 8)
  delivery_lng               Decimal?         @db.Decimal(11, 8)
  created_at                 DateTime         @default(now()) @db.Timestamp(6)
  employee                   employee         @relation(fields: [delivered_by_employee_id], references: [id], onUpdate: NoAction)
  parcel                     parcel           @relation(fields: [parcel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant                     tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model quotation {
  id                       String            @id @default(uuid(7)) @db.Uuid
  tenant_id                String            @db.Uuid
  shipment_request_id      String            @db.Uuid
  origin_org_unit_id       String            @db.Uuid
  destination_org_unit_id  String            @db.Uuid
  quotation_type           QuotationType     @default(AUTOMATIC)
  base_price               Decimal?          @db.Decimal(10, 2)
  weight_charge            Decimal?          @db.Decimal(10, 2)
  extra_fees               Decimal?          @default(0) @db.Decimal(10, 2)
  amount                   Decimal?          @db.Decimal(10, 2)
  pricing_snapshot         Json?
  notes                    String?
  valid_until              DateTime?         @db.Timestamp(6)
  status                   QuotationStatus   @default(PENDING)
  submitted_by_employee_id String?           @db.Uuid
  created_at               DateTime          @default(now()) @db.Timestamp(6)
  updated_at               DateTime          @updatedAt
  service_level            ServiceLevel      @default(STANDARD)
  destination_org_unit     organization_unit @relation("quotation_destinationToorganization_unit", fields: [destination_org_unit_id], references: [id], onUpdate: NoAction)
  origin_org_unit          organization_unit @relation("quotation_originToorganization_unit", fields: [origin_org_unit_id], references: [id], onUpdate: NoAction)
  shipment_request         shipment_request  @relation(fields: [shipment_request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee                 employee?         @relation(fields: [submitted_by_employee_id], references: [id], onUpdate: NoAction)
  tenant                   tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  approved_for_request     shipment_request? @relation("ApprovedQuotation")

  @@index([shipment_request_id])
  @@index([tenant_id])
}

model role {
  id              String            @id @default(uuid(7)) @db.Uuid
  tenant_id       String            @db.Uuid
  name            String            @db.VarChar(100)
  description     String?           @db.VarChar(255)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  assignment_role assignment_role[]
  tenant          tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role_permission role_permission[]

  @@unique([tenant_id, name], map: "uq_tenant_role_name")
}

model role_permission {
  id            String     @id @default(uuid(7)) @db.Uuid
  role_id       String     @db.Uuid
  permission_id String     @db.Uuid
  permission    permission @relation(fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role          role       @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([role_id, permission_id], map: "uq_role_permission")
}

model shipment_request {
  id                             String              @id @default(uuid(7)) @db.Uuid
  customer_profile_id            String              @db.Uuid
  target_tenant_id               String?             @db.Uuid
  origin_global_location_id      String              @db.Uuid
  destination_global_location_id String              @db.Uuid
