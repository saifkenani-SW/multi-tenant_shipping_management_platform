{
  "name": "nestjs-storage-kit",
  "version": "0.1.0",
  "description": "Driver-based, framework-native file storage module for NestJS. Ships with a local-disk driver; the contract and module wiring are ready for S3 (or any other driver) to be added later without touching consuming apps.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nestjs",
    "storage",
    "file-upload",
    "multer"
  ],
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/schedule": "^4.0.0 || ^5.0.0",
    "multer": "^1.4.4 || ^2.0.0"
  },
  "dependencies": {
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "multer": "^1.4.5-lts.1",
    "typescript": "^5.4.0"
  }
}
